DJANGO_SECRET_KEY=change-me-before-sharing
JWT_SECRET_KEY=change-me-before-sharing
DATABASE_URL=sqlite:////app/data/app.db
STORAGE_ROOT=/app/storage
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://zanistagpteastus2.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Optional cost configuration for per-run model usage logs.
AZURE_OPENAI_INPUT_USD_PER_1M_TOKENS=
AZURE_OPENAI_OUTPUT_USD_PER_1M_TOKENS=

# Frontend-to-backend browser URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Local smoke tests can enable mock grading instead of Azure.
ALLOW_MOCK_GRADING=false

# Optional image caps for unusually large scanned PDFs.
PDF_MAX_PAGE_DIMENSION=1800
PDF_MAX_ZOOMED_DIMENSION=1800
